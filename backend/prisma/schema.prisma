// Prisma schema — StellarAID backend read model.
// On-chain state (balances, spend authorization) is the source of truth;
// this database is an index/read-model for KYC, merchants and programs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Lets `prisma migrate dev` emit `CREATE EXTENSION IF NOT EXISTS vector`
  // itself (needs `previewFeatures = ["postgresqlExtensions"]` above, on
  // the generator, to take effect) — required for `AiDocument.embedding`.
  // Some managed Postgres providers don't allow `CREATE EXTENSION` from an
  // application role; if migrate fails on this, an admin needs to run
  // `CREATE EXTENSION vector;` once, out of band, before re-running migrate.
  extensions = [vector]
}

enum Role {
  CITIZEN
  MERCHANT
  ADMIN
  AUDITOR
}

model User {
  id                  String    @id @default(cuid())
  wallet              String?   @unique
  passkeyCredentialId String?   @unique
  role                Role      @default(CITIZEN)
  country             String?
  region              String?
  kycVerifiedAt       DateTime?
  createdAt           DateTime  @default(now())

  vouchers      Voucher[]         @relation("recipient")
  redemptions   Redemption[]      @relation("spender")
  delegatedVouchers VoucherDelegate[]
}

model Merchant {
  id        String   @id @default(cuid())
  wallet    String   @unique
  name      String
  region    String
  active    Boolean  @default(true)
  onCreate  DateTime @default(now())

  redemptions Redemption[]
}

model AidProgram {
  id          String   @id @default(cuid())
  name        String
  currency    String   @default("USDC")
  totalBudget BigInt
  spentBudget BigInt   @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  vouchers Voucher[]
}

model Voucher {
  id          String  @id @default(cuid())
  voucherId   Int
  program     AidProgram @relation(fields: [programId], references: [id])
  programId   String
  recipient   User      @relation("recipient", fields: [recipientId], references: [id])
  recipientId String
  amount      BigInt
  spent       BigInt   @default(0)
  category    String
  region      String
  expiresAt   DateTime
  onChainStatus String @default("ISSUED") // ISSUED | ACTIVE | SPENT | BURNED | FROZEN
  createdAt   DateTime  @default(now())

  redemptions Redemption[]
  delegates   VoucherDelegate[]

  @@unique([programId, voucherId])
}

model Redemption {
  id        String   @id @default(cuid())
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  voucherId String
  spender   User     @relation("spender", fields: [spenderId], references: [id])
  spenderId String
  merchant  Merchant @relation(fields: [merchantId], references: [id])
  merchantId String
  amount    BigInt
  txHash    String?  // on-chain tx, set after ledger confirmation
  createdAt DateTime @default(now())
}

model VoucherDelegate {
  id         String  @id @default(cuid())
  voucher    Voucher @relation(fields: [voucherId], references: [id])
  voucherId  String
  delegate   User    @relation(fields: [delegateId], references: [id])
  delegateId String
  active     Boolean @default(true)
}

/// Records a completed write so a retried request (same client-supplied
/// `Idempotency-Key` header) replays the stored response instead of
/// re-executing an on-chain, fund-moving call a second time. See
/// `src/common/idempotency.interceptor.ts`.
model IdempotencyKey {
  key          String   @id
  responseJson String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entityType String
  entityId  String
  metadata  String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Citizen AI assistant — RAG over program/merchant/FAQ content, paid
// per-query through the existing x402 endpoint. See src/ai.
// ------------------------------------------------------------------

/// FAQ/policy text indexed for the assistant's optional semantic search
/// layer (structured Prisma queries in `RetrievalService` handle the
/// common factual questions; this is for open-ended policy questions a
/// fixed query can't answer). The `embedding` column needs the pgvector
/// extension — see the migration note in
/// `backend/src/ai/vector-store.service.ts`. Because Prisma's
/// `Unsupported(...)` type has no generated Client methods, this model is
/// only ever written/read through `$queryRawUnsafe`/`$executeRawUnsafe`
/// in that file, never through `prisma.aiDocument.*`.
model AiDocument {
  id        String                        @id @default(cuid())
  programId String?
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                      @default(now())
}

// ------------------------------------------------------------------
// Event delivery — decodes aid_voucher contract events off Soroban RPC
// and fans them out over SSE / signed webhooks. See src/events, src/webhooks.
// ------------------------------------------------------------------

/// Tracks how far the event poller has read, per contract, so it resumes
/// from the right place across restarts instead of re-scanning from genesis
/// (or missing events emitted while the process was down).
model EventCursor {
  contractId  String   @id
  lastLedger  Int
  updatedAt   DateTime @updatedAt
}

/// An NGO/auditor/merchant endpoint subscribed to voucher lifecycle events.
model WebhookSubscription {
  id         String   @id @default(cuid())
  url        String
  /// HMAC-SHA256 signing secret for this subscriber. Never returned by the API.
  secret     String
  /// Event type names to deliver (e.g. "issued", "redeemed"); empty = all.
  eventTypes String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]
}

/// One delivery attempt outcome, kept for debugging and retry/backoff.
model WebhookDelivery {
  id             String               @id @default(cuid())
  subscription   WebhookSubscription  @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  eventId        String
  eventType      String
  attempt        Int                  @default(1)
  statusCode     Int?
  ok             Boolean              @default(false)
  error          String?
  createdAt      DateTime             @default(now())

  @@index([subscriptionId])
}