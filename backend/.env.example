# ---- Stellar network ----
# testnet (default) | mainnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---- Soroban deployer / treasury account ----
# NEVER commit real secrets. Inject at deploy time.
STELLAR_SIGNING_SECRET=SBXXXXKEYPAIRSECRETREPLACEME

# Deployed contract ids (after: stellar contract deploy)
AID_VOUCHER_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_TOKEN_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Server ----
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Interim shared-secret gate for admin endpoints (issue/burn), until
# SEP-45 / JWT admin auth (see docs/issues.md) replaces it. Required —
# the server refuses admin requests if this is unset.
ADMIN_API_KEY=replace-with-a-long-random-value

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_aid

# ---- x402 ----
# Url used to verify an x402 payment on (see stellar docs + Coinbase).
X402_VERIFIER_URL=https://api.example.com/x402/verify
X402_PRICE_ENDPOINT=/data/aid-summary
X402_PRICE_AMOUNT=0.01
X402_PRICE_ASSET=USDC