# ---- Stellar network ----
# testnet (default) | mainnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---- Soroban deployer / treasury account ----
# NEVER commit real secrets. Inject at deploy time.
STELLAR_SIGNING_SECRET=SBXXXXKEYPAIRSECRETREPLACEME

# Deployed contract ids (after: stellar contract deploy)
AID_VOUCHER_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_TOKEN_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Server ----
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Admin auth (JWT) ----
# Interim single-operator admin login (POST /api/auth/login), until real
# SEP-45 / user-based auth (see ROADMAP.md Phase 2) replaces it. All four
# are required — the server refuses login/authenticated requests without
# them (fails closed, same as the old shared-secret guard did).
#
# JWT_SECRET: long random value signing/verifying access tokens.
#   Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
# How long an access token stays valid. Shorter is safer; 15m is a
# reasonable default for an admin operator, not a high-traffic user base.
JWT_EXPIRES_IN=15m
ADMIN_USERNAME=admin
# bcrypt hash of the admin password — never put the plaintext password
# here. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_aid

# ---- Event engine / webhooks ----
# How often (ms) the event poller calls Soroban RPC getEvents.
EVENTS_POLL_INTERVAL_MS=5000
EVENTS_PAGE_LIMIT=100

# ---- x402 ----
# Url used to verify an x402 payment on (see stellar docs + Coinbase).
X402_VERIFIER_URL=https://api.example.com/x402/verify
X402_PRICE_ENDPOINT=/data/aid-summary
X402_PRICE_AMOUNT=0.01
X402_PRICE_ASSET=USDC
# Optional override for the /data/chat endpoint specifically — falls back
# to X402_PRICE_AMOUNT if unset.
X402_CHAT_PRICE_AMOUNT=0.01

# ---- Citizen AI assistant (backend/src/ai) ----
# Paid per query through POST /data/chat (x402). Only required if you want
# that endpoint to actually work — the rest of the backend runs fine
# without any of these set.
#
# AI_PROVIDER: "openai" (default) or "anthropic" — which SDK answers chat.
AI_PROVIDER=openai
# Model name for the selected provider (defaults: gpt-4o-mini for openai,
# claude-3-5-haiku-latest for anthropic).
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set true to also do semantic search over indexed FAQ/policy text
# (backend/src/ai/vector-store.service.ts) via pgvector. Requires the
# `vector` Postgres extension (see the `extensions = [vector]` line in
# prisma/schema.prisma) and populating the AiDocument table yourself —
# nothing ingests content into it automatically. Leave false to run the
# assistant on structured voucher/program/merchant data alone.
AI_ENABLE_VECTOR_SEARCH=false
# Embeddings only support "openai" today, independently of AI_PROVIDER —
# Anthropic has no embeddings endpoint, so a Claude-for-chat deployment
# still needs OPENAI_API_KEY set if AI_ENABLE_VECTOR_SEARCH=true.
AI_EMBEDDINGS_PROVIDER=openai
AI_EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Anomaly/fraud oracle (backend/src/fraud) ----
# A dedicated Stellar secret key, DIFFERENT from STELLAR_SIGNING_SECRET,
# granted only the on-chain oracle role via `set_oracle` (see
# contracts/src/lib.rs). This key can sign `flag_merchant`/`post_anomaly`
# ONLY — never issue_voucher/burn_expired/admin calls — so a bug or
# compromise in the scanner can't move funds or mutate merchant/voucher
# state. Generate with: node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
# then fund it (testnet friendbot) and grant it the role once as admin:
#   set_oracle(admin, <this key's public key>, true)
# Leave unset to run the scanner in observe-only mode (it still scores
# events and writes AuditLog entries; it just never posts on-chain).
AID_ORACLE_SIGNING_SECRET=
# Redeemed this many seconds or fewer after issuance is scored as a
# rapid-redemption anomaly.
FRAUD_RAPID_REDEMPTION_SECONDS=30
# A merchant redeeming this many vouchers within the velocity window is
# flagged.
FRAUD_MERCHANT_VELOCITY_WINDOW_MS=60000
FRAUD_MERCHANT_VELOCITY_THRESHOLD=10
# A recipient issued this many vouchers within the fan-out window is
# flagged as a possible sybil/voucher-farming pattern.
FRAUD_RECIPIENT_FANOUT_WINDOW_MS=3600000
FRAUD_RECIPIENT_FANOUT_THRESHOLD=5
# Minimum gap between two on-chain posts for the same voucher/merchant/
# recipient, so a sustained burst doesn't spam flag_merchant/post_anomaly.
FRAUD_FLAG_COOLDOWN_MS=600000